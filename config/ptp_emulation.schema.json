{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PTP_EMULATION configuration, integer ticks of 16 ns",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "enum": [1], "default": 1},
    "capacity": {"type": "integer", "minimum": 1, "maximum": 60, "default": 1},
    "nodes": {"type": "integer", "minimum": 3, "maximum": 180, "default": 3},
    "run_id": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615, "default": 1},
    "period_ticks": {"type": "integer", "minimum": 626, "maximum": 16777215, "default": 6250},
    "maintenance_ratio": {"type": "integer", "minimum": 1, "maximum": 65535, "default": 10},
    "epoch_ticks": {"type": "integer", "minimum": 0, "maximum": 140737488355327, "default": 500000},
    "pulse_width_ticks": {"type": "integer", "minimum": 1, "maximum": 625, "default": 64},
    "sample_period_ticks": {"type": "integer", "minimum": 1, "maximum": 4294967295, "default": 62500},
    "duration_ticks": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615, "default": 0},
    "seed": {"type": "integer", "minimum": 1, "maximum": 4294967293, "default": 1},
    "jitter_mask": {"type": "integer", "enum": [0,1,3,7,15,31,63,127,255], "default": 0},
    "drop_every": {"type": "integer", "minimum": 0, "maximum": 65535, "default": 0},
    "drift_ppb": {"type": "array", "maxItems": 180, "default": [], "items": {"type": "integer", "minimum": -1000000, "maximum": 1000000}},
    "offset_ticks": {"type": "array", "maxItems": 180, "default": [], "items": {"type": "integer", "minimum": -1000000000, "maximum": 1000000000}},
    "links": {"type": "array", "maxItems": 179, "default": [], "items": {
      "type": "object", "additionalProperties": false, "required": ["forward_ticks", "reverse_ticks"],
      "properties": {"forward_ticks": {"type": "integer", "minimum": 1, "maximum": 4095}, "reverse_ticks": {"type": "integer", "minimum": 1, "maximum": 4095}}
    }}
  }
}
